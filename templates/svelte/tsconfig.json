{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client",
      "svelte",
      "bun"
    ],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
